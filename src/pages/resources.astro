---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import EbookCover from '~/components/promdi/EbookCover.astro';
import { FEATURES } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Free Resources for Filipino Business Owners',
  description:
    'Practical guides and tools from PromdiPreneur for Filipino entrepreneurs who want more organized businesses.',
};
---

<Layout metadata={metadata}>
  <Section
    id="resources"
    headingLevel="h1"
    eyebrow="Resources"
    title="Free resources for Filipino business owners"
    intro="Practical, no-fluff material to help you organize your business. We only publish a resource when it’s ready."
  >
    <article class="pp-card p-6 md:p-10 grid md:grid-cols-[auto_1fr] gap-8 items-center">
      <EbookCover />
      <div>
        <div class="flex flex-wrap gap-2">
          <span class="pp-badge bg-[#eef4ee] text-[#004c25]">Featured</span>
          {!FEATURES.ebookLive && <span class="pp-badge bg-[#f6ecdf] text-[#754000]">Coming soon</span>}
        </div>
        <h2 class="mt-3 text-2xl md:text-3xl font-extrabold">Free Business Guide</h2>
        <p class="mt-2 text-muted text-lg">
          A practical guide for owners who want to move from diskarte to systems: fewer missed customers, less repeat
          work, a business that runs without you chasing everything.
        </p>
        <a
          href={getPermalink('/free-guide')}
          class="btn-primary mt-6"
          data-track="ebook_cta_click"
          data-placement="resources"
        >
          {FEATURES.ebookLive ? 'Get the Free Guide' : 'See the Free Guide'}
          <Icon name="tabler:arrow-right" class="w-4 h-4 ml-2" />
        </a>
      </div>
    </article>
    <p class="mt-8 text-muted">
      More checklists and guides will be added here as they’re finished. Have a topic you’d like covered? <a
        class="underline text-[#0b7339]"
        href={getPermalink('/contact')}>Tell us</a
      >.
    </p>
  </Section>
</Layout>
