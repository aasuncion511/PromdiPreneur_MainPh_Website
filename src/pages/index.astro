---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import headshot from '~/assets/images/profile/allan-minbizcon-800.webp';
import crewPhoto from '~/assets/images/hub/fresh-start-crew-1512.webp';
import steamClean from '~/assets/images/hub/fresh-start-steam-clean.webp';
import payrollDash from '~/assets/images/hub/payroll-dashboard-demo.webp';
import payrollMenu from '~/assets/images/hub/payroll-menu.webp';
import minbizDesk from '~/assets/images/hub/minbizcon-desk-1100.webp';
import minbizPass from '~/assets/images/hub/minbizcon-pass-blurred.webp';
import minbizBanner from '~/assets/images/hub/minbizcon-partner-banner.webp';
import minbizTeam from '~/assets/images/hub/minbizcon-team-blurred.webp';
import { CTA, EBOOK } from '~/data/brand';
import { COST_BARS, COST_FOOTNOTE, PACKAGES } from '~/data/pricing';
import { getPermalink } from '~/utils/permalinks';

// Homepage v2 front revision (docs/HOMEPAGE_V2.md), built section by section with Allan's approval.
// Sections below the hero are still v3 until their step is approved.
const metadata = {
  title: 'PromdiPreneur | Business Systems & Automation for Filipino Businesses',
  ignoreTitleTemplate: true,
  description:
    'Websites, customer inquiries, sales follow-ups and daily operations: PromdiPreneur implements practical systems that help Filipino businesses stay organized and grow.',
};
// Homepage v2 §3.3: before/after cards.
const LEAKS = [
  {
    problem: 'Inquiries sa FB, Viber, text — may hindi nasasagot. Bumibili sila sa iba.',
    fix: 'One inbox. Auto-reply in seconds. Walang naiiwan.',
  },
  {
    problem: 'Nagpadala ng quote… tapos wala na. Lumamig ang lead.',
    fix: 'Automatic follow-ups until they say yes or no.',
  },
  { problem: 'Lahat dumadaan sa’yo. Hindi ka maka-day off.', fix: 'Simple SOPs and checklists your team follows.' },
];
// Homepage v2 §3.11. Reworded by Allan's request (2026-11-01): more formal, still casual.
const FOUNDER_QUOTE =
  'Hindi software ang ibinebenta ko. Tinutulungan kong maayos ang inyong negosyo — gamit ang mga sistemang subok na sa sarili kong mga negosyo.';
// Homepage v2 §3.12, rewritten for owners new to systems and automation (Allan, 2026-11-01).
// Answers stay within Allan's package terms and portfolio; no prices here (prices live only in #pricing).
const FAQS = [
  {
    q: 'Ano ba talaga ang “business system” at “automation”?',
    a: 'A business system is the agreed way work gets done — how an inquiry is answered, quoted, booked, paid and followed up — written down so anyone on your team can follow it. Automation lets software do the repetitive parts, like instant replies, reminders, follow-ups and admin alerts, the same way every time. Isipin mo itong checklist na tumatakbo nang mag-isa.',
  },
  {
    q: 'Maliit pa lang ang negosyo ko. Kailangan ko na ba ito?',
    a: 'Kung may inquiries na hindi nasasagot, quotes na hindi na-follow up, o lahat dumadaan pa sa’yo — oo. Small businesses usually lose sales in exactly these places. You don’t need everything at once: we fix one problem first, then grow the system with your business.',
  },
  {
    q: 'Hindi ako techy. Kaya ko ba ito?',
    a: 'Oo. We set it up, train your team, and leave simple step-by-step guides. Your staff just follows the process.',
  },
  {
    q: 'Papalitan ba nito ang staff ko? Robot ba ang kakausap sa customers ko?',
    a: 'Hindi. The system handles the first reply, follow-ups and reminders so nothing is missed — your people still do the closing and serving. Customers get a fast answer, and anything that needs a real person goes to you or your team.',
  },
  {
    q: 'Kailangan ko bang bumili ng bagong software?',
    a: 'Not always. We map your process first, then pick tools — and we prefer the ones you already pay for.',
  },
  {
    q: 'Bakit may monthly care plan?',
    a: 'Systems need upkeep: apps update, your prices and process change, staff come and go. The care plan means we maintain and fine-tune the system after go-live — hindi ka iiwan pagkatapos ma-setup.',
  },
  {
    q: 'Ano ang hindi kasama sa package?',
    a: 'SMS, calls, WhatsApp, AI usage, payment gateway fees, ad spend and third-party subscriptions are billed at actual cost. Large multi-page websites and onsite manpower are separate.',
  },
  {
    q: 'Taga-CDO lang ba ang clients ninyo?',
    a: 'We’re based in Cagayan de Oro, but we work online with businesses anywhere in the Philippines and abroad.',
  },
  {
    q: 'Ano ang mangyayari sa Discovery Call?',
    a: 'We talk through how inquiries, sales and daily work move in your business, and where they leak. You get a straight answer on what to fix first — even if you don’t hire us.',
  },
];
// Homepage v2 §3.6
const INDUSTRIES = [
  { slug: 'cleaning', name: 'Cleaning & Services', setup: 'Booking, quotes, crew schedule' },
  { slug: 'food', name: 'Food Business', setup: 'Orders, payments, repeat buyers' },
  { slug: 'trading', name: 'Trading & Supply', setup: 'Quotations, inventory, re-orders' },
  { slug: 'events', name: 'Events & Conferences', setup: 'Registration, QR check-in, attendance' },
  { slug: 'rentals', name: 'Rentals & Resorts', setup: 'Date checks, reservation fees, calendar' },
  { slug: 'clinics', name: 'Clinics & Salons', setup: 'Appointments, reminders, no-show handling' },
];
// Homepage v2 §3.8
const STEPS = [
  { title: 'Free Discovery Call', body: 'We find where your sales and time are leaking.' },
  { title: 'Map the Process', body: 'A clear map: steps, owners, tools — before we build.' },
  { title: 'Build, Train, Improve', body: 'We set it up, train your team, and stay to fine-tune.' },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero (Homepage v2 §3.2) -->
  <section class="bg-[#00330f] text-white">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-14 md:pt-20 md:pb-16 grid lg:grid-cols-[1.1fr_.9fr] gap-12 lg:gap-14 items-center"
    >
      <div class="flex flex-col gap-6">
        <p
          class="self-start rounded-full bg-[#1db259]/15 px-3.5 py-2 font-heading text-sm font-semibold text-[#5fd68f]"
        >
          Business Systems &amp; Automation · Para sa Filipino MSMEs
        </p>
        <h1 class="!text-white text-[2.4rem] sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.05] tracking-tight">
          Hindi ka kulang sa sipag. <span class="block text-[#1db259]">Kulang ka sa sistema.</span>
        </h1>
        <p class="text-lg md:text-xl leading-relaxed text-[#c9dccf] max-w-xl">
          We set up your inquiries, follow-ups and daily operations — so sales stop slipping and the business runs even
          when you step away.
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3">
          <a href={getPermalink('/discovery')} class="btn-bright text-lg !px-7" data-placement="hero">{CTA.primary}</a>
          <TrackedLink dest="messenger" placement="hero" class="btn-ghost-dark text-lg gap-2.5">
            <Icon name="tabler:brand-messenger" class="w-5 h-5" aria-hidden="true" />
            Message us on Messenger
          </TrackedLink>
        </div>
        <div class="flex items-center gap-3">
          <Image
            src={headshot}
            alt="Allan Asuncion"
            widths={[96, 144]}
            sizes="48px"
            class="w-12 h-12 rounded-full object-cover border-2 border-[#1db259]"
            loading="eager"
          />
          <p class="text-sm leading-snug text-[#9fbfab]">
            <span class="font-semibold text-white">Diretso kay Allan ang usapan.</span><br />Free · Walang obligasyon ·
            We reply within the day
          </p>
        </div>
      </div>

      <!-- Coded phone mockup: an example Messenger flow (HTML/CSS, not an image) -->
      <figure
        class="relative flex justify-center pt-6 pb-6 sm:pt-20"
        aria-label="Example: an organized Messenger inquiry"
      >
        <div
          class="w-[min(300px,82vw)] rounded-[36px] border-[10px] border-[#0d1a12] bg-white text-[#14231a] shadow-[0_30px_60px_rgba(0,0,0,.45)] overflow-hidden"
        >
          <div class="flex items-center gap-2.5 border-b border-[#e8ece9] px-4 py-3.5">
            <span
              class="grid place-items-center w-[34px] h-[34px] rounded-full bg-[#00441b] text-white text-[13px] font-bold"
              aria-hidden="true">FS</span
            >
            <span class="flex flex-col leading-tight">
              <span class="text-sm font-semibold">Fresh Start Cleaning</span>
              <span class="text-xs text-[#4f6b5a]">Typically replies instantly</span>
            </span>
          </div>
          <ol class="flex flex-col gap-2.5 px-3.5 py-4 min-h-[330px] text-sm leading-snug" aria-label="Sample chat">
            <li class="self-end max-w-[80%] rounded-[18px_18px_4px_18px] bg-[#006ae0] px-3.5 py-2.5 text-white">
              Hi po, magkano sofa cleaning? 3-seater po.
            </li>
            <li class="self-start max-w-[85%] rounded-[18px_18px_18px_4px] bg-[#eef1ef] px-3.5 py-2.5">
              Hi po! Salamat sa message. Para ma-quote kayo agad, ano po ang lilinisin?
            </li>
            <li class="flex flex-wrap gap-1.5" aria-label="Quick replies">
              {
                ['Sofa', 'Mattress', 'Post-construction'].map((c) => (
                  <span class="rounded-full border-[1.5px] border-[#006ae0] px-3 py-1.5 text-[13px] font-semibold text-[#0060c0]">
                    {c}
                  </span>
                ))
              }
            </li>
            <li class="self-end rounded-[18px_18px_4px_18px] bg-[#006ae0] px-3.5 py-2.5 text-white">Sofa</li>
            <li class="self-start max-w-[85%] rounded-[18px_18px_18px_4px] bg-[#eef1ef] px-3.5 py-2.5">
              Noted po! Pick a schedule para ma-book na kayo:
            </li>
            <li class="self-start rounded-xl bg-[#00441b] px-3.5 py-2.5 text-[13px] font-semibold text-white">
              Book a slot →
            </li>
          </ol>
        </div>
        <div
          class="absolute left-0 top-0 hidden sm:flex w-[210px] items-center gap-2.5 rounded-[14px] bg-white px-3.5 py-3 text-[#14231a] shadow-[0_12px_30px_rgba(0,0,0,.3)] motion-safe:animate-fade"
          style="animation-delay:400ms"
        >
          <span
            class="grid place-items-center w-8 h-8 shrink-0 rounded-lg bg-[#f3e6d8] text-[#663300]"
            aria-hidden="true"
          >
            <Icon name="tabler:user-plus" class="w-[18px] h-[18px]" />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="text-[13px] font-bold">New lead added</span>
            <span class="text-xs text-[#4f6b5a]">Follow-up set: bukas 9AM</span>
          </span>
        </div>
        <div
          class="absolute right-0 bottom-14 hidden sm:flex w-[224px] items-center gap-2.5 rounded-[14px] bg-white px-3.5 py-3 text-[#14231a] shadow-[0_12px_30px_rgba(0,0,0,.3)] motion-safe:animate-fade"
          style="animation-delay:700ms"
        >
          <span
            class="grid place-items-center w-8 h-8 shrink-0 rounded-lg bg-[#dff3e6] text-[#00441b]"
            aria-hidden="true"
          >
            <Icon name="tabler:check" class="w-[18px] h-[18px]" />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="text-[13px] font-bold">Booked · Sat 10:00 AM</span>
            <span class="text-xs text-[#4f6b5a]">Crew notified</span>
          </span>
        </div>
      </figure>
    </div>

    <!-- Trust strip -->
    <div class="border-t border-white/10">
      <ul
        class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[#9fbfab]"
      >
        <li class="font-semibold text-white">
          20+ years running real businesses. Every system tested on our own first:
        </li>
        <li>Fresh Start Cleaning Services</li>
        <li>AJDA Enterprises</li>
        <li>PromdiPreneur Payroll</li>
        <li>Official Digital Check-In Partner, 35th MinBizCon</li>
      </ul>
    </div>
  </section>

  <!-- 3. Where sales leak (Homepage v2 §3.3) -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-[88px]">
      <div class="text-center">
        <h2 class="!text-[#00330f] text-3xl md:text-[2.5rem] font-extrabold leading-tight">
          Saan nag-le-leak ang benta mo?
        </h2>
        <p class="mt-3 text-lg text-muted">Three problems we fix in almost every business we visit.</p>
      </div>
      <ul class="mt-10 grid md:grid-cols-3 gap-5">
        {
          LEAKS.map((l) => (
            <li class="rounded-[20px] border border-[#e3e8e4] overflow-hidden flex flex-col">
              <p class="flex gap-3 items-start bg-[#fbf3f1] p-6 text-[17px] leading-snug text-[#5a2a1f]">
                <span class="grid place-items-center w-7 h-7 shrink-0 rounded-full bg-[#f2d6cf] text-[#9a2b14]">
                  <Icon name="tabler:x" class="w-3.5 h-3.5" />
                  <span class="sr-only">Problem:</span>
                </span>
                {l.problem}
              </p>
              <p class="flex gap-3 items-start p-6 text-[17px] leading-snug font-semibold text-default">
                <span class="grid place-items-center w-7 h-7 shrink-0 rounded-full bg-[#dff3e6] text-[#00441b]">
                  <Icon name="tabler:check" class="w-3.5 h-3.5" />
                  <span class="sr-only">Fix:</span>
                </span>
                {l.fix}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Real-team photo band (Homepage v2 §3.4) -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 md:pb-[88px]">
      <figure class="relative rounded-3xl overflow-hidden bg-[#00330f] md:h-[460px]">
        <Image
          src={crewPhoto}
          alt="Fresh Start Cleaning crew standing in front of a newly finished building"
          widths={[640, 960, 1280, 1512]}
          sizes="(min-width: 1280px) 1232px, calc(100vw - 32px)"
          class="w-full h-[240px] sm:h-[320px] md:h-full object-cover object-[center_100%]"
          loading="lazy"
        />
        <figcaption
          class="md:absolute md:inset-x-0 md:bottom-0 p-6 md:p-8 md:bg-gradient-to-t md:pt-24 md:from-[rgba(0,30,15,.94)] md:via-[rgba(0,30,15,.7)] md:to-transparent flex flex-wrap justify-between items-end gap-4"
        >
          <span class="flex flex-col gap-1.5 max-w-[620px]">
            <span class="font-heading text-[13px] font-bold tracking-[0.08em] text-[#5fd68f]"
              >OUR OWN CREW · FRESH START CLEANING SERVICES</span
            >
            <span class="font-heading text-2xl md:text-[30px] leading-tight font-extrabold text-white"
              >Hindi kami consultant na puro slides. May tauhan, may trabaho, may sistema.</span
            >
          </span>
          <a href="#results" class="btn bg-white text-[#00330f] border-white font-bold hover:bg-green-50"
            >See how we run it →</a
          >
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. What we set up (Homepage v2 §3.5) -->
  <section id="solutions" class="scroll-mt-20 bg-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-[88px]">
      <div class="flex flex-wrap justify-between items-end gap-4">
        <div>
          <p class="font-heading text-sm font-bold tracking-[0.08em] text-[#00441b]">WHAT WE SET UP</p>
          <h2 class="mt-2.5 !text-[#00330f] text-3xl md:text-[2.5rem] font-extrabold leading-tight">
            From first message to paid job.
          </h2>
        </div>
        <p class="text-[17px] text-muted max-w-[380px]">
          One connected system, not five apps that don’t talk to each other. Built on GoHighLevel and Google Workspace —
          and we prefer tools you already pay for.
        </p>
      </div>
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <li class="rounded-[20px] border border-[#e3e8e4] bg-white p-5 flex flex-col gap-4">
          <div class="h-[150px] rounded-xl bg-[#eef4ee] p-3.5 flex flex-col gap-2" aria-hidden="true">
            <div class="h-2.5 w-2/5 rounded bg-[#00441b]"></div>
            <div class="h-[18px] w-[85%] rounded bg-[#c9dccf]"></div>
            <div class="h-2.5 w-[65%] rounded bg-[#dbe6de]"></div>
            <div class="mt-auto h-[30px] w-1/2 rounded-full bg-[#1db259]"></div>
          </div>
          <h3 class="!text-[#00330f] text-xl font-bold">Website &amp; Funnel</h3>
          <p class="text-[15px] leading-normal text-muted">Mahanap ka online — and turn visitors into inquiries.</p>
        </li>
        <li class="rounded-[20px] border border-[#e3e8e4] bg-white p-5 flex flex-col gap-4">
          <div class="h-[150px] rounded-xl bg-[#eef4ee] p-3 grid grid-cols-3 gap-2" aria-hidden="true">
            {
              [
                ['NEW', 3],
                ['QUOTED', 2],
                ['BOOKED', 1],
              ].map(([label, n]) => (
                <div class="flex flex-col gap-1.5">
                  <span class="text-[11px] font-bold text-[#00441b]">{label}</span>
                  {Array.from({ length: Number(n) }).map(() => (
                    <div class:list={['h-[26px] rounded-md', label === 'BOOKED' ? 'bg-[#1db259]' : 'bg-white']} />
                  ))}
                </div>
              ))
            }
          </div>
          <h3 class="!text-[#00330f] text-xl font-bold">CRM &amp; Follow-up</h3>
          <p class="text-[15px] leading-normal text-muted">
            Every lead in one board. Kita mo kung sino ang susunod na tatawagan.
          </p>
        </li>
        <li class="rounded-[20px] border border-[#e3e8e4] bg-white p-5 flex flex-col gap-4">
          <div
            class="h-[150px] rounded-xl bg-[#eef4ee] p-3.5 flex flex-col justify-center items-start gap-1.5 text-xs"
            aria-hidden="true"
          >
            <span class="rounded-lg border border-[#c9dccf] bg-white px-2.5 py-1.5 font-semibold">New inquiry</span>
            <span class="ml-4 text-muted">↓</span>
            <span class="ml-4 rounded-lg border border-[#c9dccf] bg-white px-2.5 py-1.5 font-semibold"
              >Auto-reply + quote</span
            >
            <span class="ml-8 text-muted">↓</span>
            <span class="ml-8 rounded-lg bg-[#00441b] px-2.5 py-1.5 font-semibold text-white">Admin notified</span>
          </div>
          <h3 class="!text-[#00330f] text-xl font-bold">Automation</h3>
          <p class="text-[15px] leading-normal text-muted">
            Paulit-ulit na trabaho, automatic na — same way, every time.
          </p>
        </li>
        <li class="rounded-[20px] border border-[#e3e8e4] bg-white p-5 flex flex-col gap-4">
          <div class="h-[150px] rounded-xl bg-[#eef4ee] p-3.5 flex items-end gap-2.5" aria-hidden="true">
            {
              [
                ['35%', '#c9dccf'],
                ['50%', '#c9dccf'],
                ['45%', '#c9dccf'],
                ['70%', '#00441b'],
                ['90%', '#1db259'],
              ].map(([h, c]) => <div class="flex-1 rounded-t-md" style={`height:${h};background:${c}`} />)
            }
          </div>
          <h3 class="!text-[#00330f] text-xl font-bold">Operations &amp; Reports</h3>
          <p class="text-[15px] leading-normal text-muted">
            SOPs, records and a sales view you can check on your phone.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 6. Industry picker (Homepage v2 §3.6). Tiles go to Discovery for now (Allan, 2026-11-01). -->
  <section class="bg-[#00441b] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-[72px]">
      <h2 class="!text-white text-center text-3xl md:text-4xl font-extrabold">Ano ang negosyo mo?</h2>
      <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {
          INDUSTRIES.map((t) => (
            <li>
              <a
                href={getPermalink('/discovery')}
                class="flex h-full flex-col gap-1.5 rounded-2xl border border-white/20 bg-white/[0.08] p-[22px] text-white transition-colors hover:bg-white/[0.14] hover:border-white/40"
                data-event="industry_tile_click"
                data-placement={`industry_${t.slug}`}
              >
                <span class="font-heading text-lg font-bold">{t.name}</span>
                <span class="text-sm text-[#c9dccf]">{t.setup}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Results (Homepage v2 §3.7) -->
  <section id="results" class="scroll-mt-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-[88px]">
      <p class="font-heading text-sm font-bold tracking-[0.08em] text-[#00441b]">REAL WORK, NOT MOCKUPS</p>
      <h2 class="mt-2.5 !text-[#00330f] text-3xl md:text-[2.5rem] font-extrabold leading-tight">
        We run our own businesses on these systems.
      </h2>
      <ul class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
        <li class="flex flex-col gap-3.5">
          <Image
            src={steamClean}
            alt="Fresh Start cleaner steam-cleaning a sofa in a condo unit"
            widths={[480, 760]}
            sizes="(min-width: 1024px) 380px, (min-width: 768px) 45vw, 100vw"
            class="w-full h-60 object-cover object-[center_40%] rounded-[18px]"
            loading="lazy"
          />
          <p class="font-heading text-[13px] font-bold text-[#00441b]">FRESH START CLEANING · CDO</p>
          <h3 class="!text-default text-[22px] font-bold leading-snug">Instant replies, 24/7 — handled by AI</h3>
          <p class="text-muted">About 7 bookings every week: 4 sofa, 2 house/apartment, 1 mattress.</p>
        </li>
        <li class="flex flex-col gap-3.5">
          <div class="relative h-60 rounded-[18px] overflow-hidden border border-[#e3e8e4] bg-white">
            <Image
              src={payrollDash}
              alt="PromdiPreneur Payroll dashboard in Google Sheets showing a finalized period with net payroll and withholding tax totals (demo data)"
              widths={[480, 760, 1200]}
              sizes="(min-width: 1024px) 380px, (min-width: 768px) 45vw, 100vw"
              class="w-full h-full object-cover object-left-top"
              loading="lazy"
            />
            <Image
              src={payrollMenu}
              alt="Promdipreneur Payroll menu: Prepare, Validate, Finalize, Mark Paid, and email payslips"
              widths={[300]}
              sizes="150px"
              class="absolute right-2.5 bottom-2.5 w-[150px] rounded-lg border border-[#e3e8e4] shadow-[0_8px_20px_rgba(0,0,0,.25)]"
              loading="lazy"
            />
