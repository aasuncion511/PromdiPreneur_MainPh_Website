---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { BRAND, CTA } from '~/data/brand';
import { SERVICE_GROUPS, SEQUENCE, SERVICE_FAQS } from '~/data/services';
import { getPermalink } from '~/utils/permalinks';

// v3 §5: PromdiPreneur Systems capability groupings (not priced packages). problem → what we do → what changes → CTA.
const metadata = {
  title: 'What We Do: PromdiPreneur Systems',
  description:
    'Websites and funnels, CRM and follow-up, operations and automation, and custom business systems for Filipino businesses. We organize the process first, then build.',
};
---

<Layout metadata={metadata}>
  <Section
    id="services"
    headingLevel="h1"
    eyebrow="What we do · PromdiPreneur Systems"
    title="We organize the process, then build the system that runs it."
    intro="We implement better ways for your business to manage inquiries, customers, sales, follow-ups and daily operations—using the right technology, explained in plain language."
  >
    <p class="font-heading font-bold text-sm uppercase tracking-[0.08em] text-[#663300] -mt-6">
      {BRAND.principle.join(' → ')}
    </p>
    <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2">
      {
        SERVICE_GROUPS.map((g) => (
          <a
            href={`#${g.id}`}
            class="rounded-full bg-white border border-black/10 px-4 py-2.5 font-heading font-semibold text-sm text-primary hover:border-[#00441b]"
          >
            {g.name}
          </a>
        ))
      }
    </nav>
  </Section>

  {
    SERVICE_GROUPS.map((g, i) => (
      <section
        id={g.id}
        class:list={['py-14 md:py-20 scroll-mt-20', i % 2 ? 'bg-page' : 'bg-white']}
        aria-labelledby={`${g.id}-title`}
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[.8fr_1.2fr] gap-8 lg:gap-14">
          <div>
            <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-[#00441b] text-white">
              <Icon name={g.icon} class="w-6 h-6" />
            </span>
            <h2 id={`${g.id}-title`} class="mt-4 text-3xl font-extrabold">
              {g.name}
            </h2>
            <p class="mt-3 text-muted">
              <em>Example:</em> {g.example}
            </p>
          </div>
          <dl class="grid sm:grid-cols-3 gap-4">
            <div class="pp-card p-5">
              <dt class="pp-badge !p-0 text-[#663300]">The problem</dt>
              <dd class="mt-2">{g.problem}</dd>
            </div>
            <div class="pp-card p-5">
              <dt class="pp-badge !p-0 text-[#00441b]">What we do</dt>
              <dd class="mt-2">{g.whatWeDo}</dd>
            </div>
            <div class="pp-card p-5 bg-[#eef4ee]">
              <dt class="pp-badge !p-0 text-[#00441b]">What changes for you</dt>
              <dd class="mt-2">{g.changes}</dd>
            </div>
          </dl>
          <div class="lg:col-start-2 -mt-4">
            <a href={getPermalink('/discovery')} class="pp-text-link" data-placement={`services_${g.id}`}>
              Discuss your business <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </section>
    ))
  }

  <Section
    id="how-we-work"
    tone="forest"
    eyebrow="How we work"
    title="Understand → Organize → Build → Launch & improve"
  >
    <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        SEQUENCE.map((s, i) => (
          <li class="rounded-2xl border border-white/15 bg-white/[0.06] p-6">
            <span class="font-heading font-extrabold text-3xl text-[#7fe0a4]" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 !text-white text-lg font-bold">{s.title}</h3>
            <p class="mt-1 text-[#d3e3d9]">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 text-sm text-[#cfe0d6]">
      These are capability areas, not fixed packages. Scope, timeline and price are agreed in writing after a Discovery
      Session.
    </p>
  </Section>

  <FAQs title="Questions business owners ask" items={SERVICE_FAQS} />

  <section class="bg-gradient-to-r from-[#00330f] via-[#00441b] to-[#0a5c32] text-[#e1ece5] py-16 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="!text-white text-3xl md:text-4xl font-extrabold">Not sure where to start?</h2>
      <p class="mt-4 text-lg">That’s what the Discovery Session is for. Short, free, no obligation.</p>
      <a href={getPermalink('/discovery')} class="btn-light mt-8" data-placement="services_final">{CTA.primary}</a>
    </div>
  </section>
</Layout>
