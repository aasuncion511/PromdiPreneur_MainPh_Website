---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import CtaBand from '~/components/promdi/CtaBand.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import portrait from '~/assets/images/profile/allan-2017-800.webp';
import { BRAND } from '~/data/brand';

const metadata = {
  title: 'About PromdiPreneur',
  description:
    'PromdiPreneur is a Business Systems & Automation Implementer in Cagayan de Oro, led by Allan, with more than 20 years of business operations experience.',
};
const values = [
  {
    icon: 'tabler:building-store',
    title: 'Business first',
    body: 'We start with your customers, your team and how work really moves—not with software.',
  },
  {
    icon: 'tabler:list-check',
    title: 'Systems second',
    body: 'Clear steps, owners and records your team can follow on a busy day.',
  },
  {
    icon: 'tabler:device-laptop',
    title: 'Technology third',
    body: 'Then the tools: CRM, forms, automations and AI, only where they help.',
  },
];
---

<Layout metadata={metadata}>
  <Section
    id="about"
    headingLevel="h1"
    eyebrow={`About · ${BRAND.role}`}
    title="Business experience first. Technology second."
  >
    <div class="grid md:grid-cols-[.8fr_1.2fr] gap-10 items-start">
      <figure class="max-w-[360px]">
        <Image
          src={portrait}
          alt="Allan, founder of PromdiPreneur"
          widths={[360, 720]}
          sizes="360px"
          class="rounded-3xl aspect-square object-cover shadow-lg"
          loading="eager"
        />
        <figcaption class="mt-3 text-sm text-muted">
          <strong class="block text-default font-heading text-base">Allan</strong>Founder · {BRAND.location}
        </figcaption>
      </figure>
      <div class="text-lg leading-relaxed space-y-5 text-default">
        <p>
          PromdiPreneur is led by Allan, a Cagayan de Oro-based entrepreneur and business systems practitioner with more
          than 20 years of experience across business operations, sales and implementation.
        </p>
        <p>
          We understand that running an SME means wearing many hats. Our goal is to make the work more organized,
          manageable and easier to grow.
        </p>
        <p>
          We also run our own businesses on the same kind of systems we build for clients—a cleaning service company, a
          digital products store and a payroll product—so our advice comes from daily operations, not theory.
        </p>
        <p class="pp-tagline">{BRAND.tagline}</p>
        <p class="text-base text-muted">
          <em>Diskarte</em> is the Filipino knack for getting things done on the fly. We help turn it into a process your
          team can follow.
        </p>
      </div>
    </div>
  </Section>
  <Section id="principles" tone="white" title="How we think">
    <ul class="grid md:grid-cols-3 gap-5">
      {
        values.map((v) => (
          <li class="pp-card p-6">
            <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-green-50 text-primary">
              <Icon name={v.icon} class="w-6 h-6" />
            </span>
            <h3 class="mt-4 text-lg font-bold">{v.title}</h3>
            <p class="mt-1 text-muted">{v.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section id="more" narrow>
    <p class="text-lg text-muted">
      For deeper credentials, project history and case studies:
      <TrackedLink dest="portfolio" placement="about_page" class="pp-text-link"
        >View International Portfolio</TrackedLink
      >
    </p>
  </Section>
  <CtaBand placement="about_final" />
</Layout>
