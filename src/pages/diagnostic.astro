---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import InquiryForm from '~/components/promdi/InquiryForm.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import { DESTINATIONS, FEATURES } from '~/data/brand';

// Addendum 1 (Allan, 2026-11-01): the free 30-minute Business Systems Diagnostic with Allan, weekdays 1:30–3:30 PM
// (Philippine time). /discovery redirects here. It embeds the GHL calendar only when FEATURES.bookingLive is true;
// until then it never shows a fake booking widget (calendar URL: TODO: VERIFY).
const metadata = {
  title: 'Book a free Business Systems Diagnostic',
  description:
    'A free 30-minute session with Allan to map how your inquiries, sales and daily work move, and what to fix first. Weekdays, 1:30–3:30 PM.',
};
const booking = DESTINATIONS.discoveryBooking;
const expect = [
  'We listen to how inquiries, sales and daily work move in your business today.',
  'We point out where leads, time or money are most likely leaking.',
  'You get a practical suggestion of what to organize first—whether or not you work with us.',
];
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-20" aria-labelledby="disc-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[.9fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div>
        <p class="pp-eyebrow">Business Systems Diagnostic</p>
        <h1 id="disc-title" class="text-4xl md:text-5xl font-extrabold leading-tight">
          Map your process with Allan before anything gets built.
        </h1>
        <p class="mt-5 text-lg text-muted">A free 30-minute session. No obligation and no hard sell.</p>
        <ul class="mt-5 flex flex-wrap gap-2 text-sm font-semibold text-[#00441b]">
          <li class="rounded-full bg-[#eef4ee] px-3 py-1.5">30 minutes</li>
          <li class="rounded-full bg-[#eef4ee] px-3 py-1.5">Weekdays, 1:30–3:30 PM (PH time)</li>
          <li class="rounded-full bg-[#eef4ee] px-3 py-1.5">Free</li>
        </ul>
        <p class="mt-5 text-[15px] text-muted">
          Not sure yet? Take the{' '}
          <TrackedLink
            dest="discovery"
            placement="diagnostic_page"
            sameTab
            class="underline text-[#00441b] font-semibold">free 5-minute Business Discovery</TrackedLink
          >{' '}
          first. No call needed.
        </p>
        <h2 class="mt-8 text-lg font-bold">What to expect</h2>
        <ul class="mt-3 space-y-2">
          {
            expect.map((t) => (
              <li class="flex gap-2">
                <Icon name="tabler:check" class="w-5 h-5 mt-0.5 shrink-0 text-[#00441b]" />
                {t}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm text-muted">
          Prefer chat? <TrackedLink dest="messenger" placement="diagnostic" class="underline text-[#00441b]"
            >Message us on Messenger</TrackedLink
          >.
        </p>
      </div>
      <div class="pp-card p-5 md:p-8 shadow-xl">
        {
          FEATURES.bookingLive && booking.url ? (
            <>
              <h2 class="text-2xl font-bold">Pick a time</h2>
              <p class="mt-1 mb-5 text-muted">Choose a slot that suits you. You’ll get a confirmation by email.</p>
              {/* The existing GHL calendar, embedded as-is (no copy of its logic on this site). */}
              <iframe
                src={booking.url}
                title="Book a free Business Systems Diagnostic with PromdiPreneur"
                class="w-full min-h-[760px] rounded-xl border border-black/10 bg-white"
                loading="lazy"
                data-track-view="diagnostic_calendar_view"
              />
              <p class="mt-3 text-sm text-muted text-center">
                Calendar not loading?{' '}
                <TrackedLink dest="discoveryBooking" placement="diagnostic_fallback" class="underline text-[#00441b]">
                  Open it in a new tab
                </TrackedLink>
                .
              </p>
            </>
          ) : (
            <>
              <h2 class="text-2xl font-bold">Request your Diagnostic</h2>
              <p class="mt-1 mb-5 text-muted">
                Online booking is being set up. Tell us a little about your business, and we’ll reply to schedule a
                weekday slot between 1:30 and 3:30 PM.
              </p>
              <InquiryForm />
            </>
          )
        }
      </div>
    </div>
  </section>
</Layout>
