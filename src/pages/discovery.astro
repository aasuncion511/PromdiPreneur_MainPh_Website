---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import InquiryForm from '~/components/promdi/InquiryForm.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import { DESTINATIONS, FEATURES } from '~/data/brand';

// v3 §3: stable route for the Discovery Session. It links/embeds the EXISTING verified GHL calendar only when
// FEATURES.bookingLive is true; until then it never shows a fake booking widget (calendar URL: TODO: VERIFY).
const metadata = {
  title: 'Book a Discovery Session',
  description:
    'A short, free conversation about your business: where inquiries, follow-ups or admin time are being lost, and what to fix first.',
};
const booking = DESTINATIONS.discoveryBooking;
const expect = [
  'We listen to how inquiries, sales and daily work move in your business today.',
  'We point out where leads, time or money are most likely leaking.',
  'You get a practical suggestion of what to organize first—whether or not you work with us.',
];
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-20" aria-labelledby="disc-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[.9fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div>
        <p class="pp-eyebrow">Discovery Session</p>
        <h1 id="disc-title" class="text-4xl md:text-5xl font-extrabold leading-tight">
          Find out what’s causing missed leads or wasted admin time.
        </h1>
        <p class="mt-5 text-lg text-muted">
          A short, free conversation about your business. No obligation and no hard sell.
        </p>
        <h2 class="mt-8 text-lg font-bold">What to expect</h2>
        <ul class="mt-3 space-y-2">
          {
            expect.map((t) => (
              <li class="flex gap-2">
                <Icon name="tabler:check" class="w-5 h-5 mt-0.5 shrink-0 text-[#0b7339]" />
                {t}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm text-muted">
          Prefer chat? <TrackedLink dest="messenger" placement="discovery" class="underline text-[#0b7339]"
            >Message us on Facebook</TrackedLink
          >.
        </p>
      </div>
      <div class="pp-card p-5 md:p-8 shadow-xl">
        {
          FEATURES.bookingLive && booking.url ? (
            <>
              <h2 class="text-2xl font-bold">Pick a time</h2>
              <p class="mt-1 mb-5 text-muted">Choose a slot that suits you. You’ll get a confirmation by email.</p>
              <TrackedLink dest="discoveryBooking" placement="discovery" class="btn-primary w-full">
                {booking.label}
              </TrackedLink>
            </>
          ) : (
            <>
              <h2 class="text-2xl font-bold">Request a Discovery Session</h2>
              <p class="mt-1 mb-5 text-muted">
                Online booking is being set up. Tell us a little about your business and when you’re usually free, and
                we’ll reply to schedule a time.
              </p>
              <InquiryForm />
            </>
          )
        }
      </div>
    </div>
  </section>
</Layout>
