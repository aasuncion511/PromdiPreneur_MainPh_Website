---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import EbookCover from '~/components/promdi/EbookCover.astro';
import GuideForm from '~/components/promdi/GuideForm.astro';
import { BRAND, CTA, FEATURES } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';

// Landing page for the free ebook. Final title/cover/contents pending (docs/EBOOK.md). Copy below avoids promising
// specific chapters until the final contents are supplied.
const metadata = {
  title: 'Free Business Guide for Filipino Entrepreneurs',
  description:
    'A free, practical guide from PromdiPreneur for Filipino business owners who want to move from diskarte to systems.',
};
const forYou = [
  'You answer customers on Messenger, Viber and calls, and some fall through the cracks',
  'Your team keeps asking you because the process lives in your head',
  'Quotes, follow-ups and records take more time than they should',
  'You want to grow, but not by working even longer hours',
];
const topics = [
  'Where businesses usually lose customers and time',
  'Simple ways to organize inquiries, follow-ups and records',
  'How to know when a tool will help—and when a clearer process comes first',
];
---

<Layout metadata={metadata}>
  <section class="bg-[radial-gradient(900px_480px_at_92%_8%,rgba(24,185,87,.12),transparent_60%)]">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20 grid lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-16 items-start"
    >
      <div>
        <p class="pp-eyebrow">Free Business Guide {!FEATURES.ebookLive && '· Coming soon'}</p>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
          From diskarte to systems: a practical guide for Filipino business owners
        </h1>
        <p class="mt-3 text-sm text-muted">Working title. Final title and cover coming soon.</p>
        <p class="mt-5 text-lg text-muted">
          Written from real operating experience—running a cleaning company, a digital products store and a payroll
          product in Cagayan de Oro—for owners who want fewer missed customers and less repeat work.
        </p>
        <div class="mt-8"><EbookCover size="lg" /></div>
      </div>
      <div class="pp-card p-6 md:p-8 shadow-xl lg:sticky lg:top-24" id="get-guide">
        <h2 class="text-2xl font-bold">{FEATURES.ebookLive ? 'Get the free guide' : 'Request the free guide'}</h2>
        <p class="mt-1 mb-5 text-muted">{FEATURES.ebookLive ? 'We’ll email it to you.' : 'Opening soon.'}</p>
        <GuideForm placement="free_guide" />
      </div>
    </div>
  </section>

  <Section id="for-you" tone="white" title="This guide is for you if…">
    <ul class="grid sm:grid-cols-2 gap-4 max-w-4xl">
      {
        forYou.map((t) => (
          <li class="flex gap-3 pp-card p-5">
            <Icon name="tabler:check" class="w-5 h-5 mt-0.5 shrink-0 text-[#0b7339]" />
            {t}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="inside"
    title="What it covers"
    intro="The detailed contents will be listed here once the final guide is approved."
  >
    <ul class="space-y-3 max-w-3xl">
      {
        topics.map((t) => (
          <li class="flex gap-3 text-lg">
            <Icon name="tabler:point-filled" class="w-4 h-4 mt-1.5 shrink-0 text-[#18b957]" />
            {t}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="next" tone="tint" narrow>
    <h2 class="text-2xl md:text-3xl font-extrabold">Have a specific problem right now?</h2>
    <p class="mt-3 text-lg text-muted">
      You don’t have to wait for the guide. Tell us what’s slowing your business down—it’s free and there’s no
      obligation.
    </p>
    <a href={getPermalink('/contact')} class="btn-primary mt-6" data-placement="free_guide_next">{CTA.primary}</a>
    <p class="mt-6 pp-tagline">{BRAND.tagline}</p>
  </Section>
</Layout>
