---
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import Layout from '~/layouts/PageLayout.astro';
import { CTA } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';
const metadata = { title: 'Page not found', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <section class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="pp-eyebrow">404</p>
    <h1 class="text-4xl font-extrabold">We couldn’t find that page.</h1>
    <p class="mt-4 text-lg text-muted">It may have moved. Try one of these instead.</p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href={getPermalink('/')} class="btn-primary">Homepage</a>
      <a href={getPermalink('/products')} class="btn">{CTA.store}</a>
      <TrackedLink dest="discovery" placement="404" sameTab class="btn">{CTA.primary}</TrackedLink>
    </div>
  </section>
</Layout>
