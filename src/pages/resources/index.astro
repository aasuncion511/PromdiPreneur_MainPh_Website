---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import EbookCover from '~/components/promdi/EbookCover.astro';
import { EBOOK } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Free Resources for Filipino Business Owners',
  description: 'Practical guides from PromdiPreneur, including the free ebook The Business Opening Checklist PH.',
};
---

<Layout metadata={metadata}>
  <Section
    id="resources"
    headingLevel="h1"
    eyebrow="Resources"
    title="Free resources for Filipino business owners"
    intro="Practical, no-fluff material to help you plan and organize your business. We publish a resource only when it’s ready."
  >
    <article class="pp-card p-6 md:p-10 grid md:grid-cols-[auto_1fr] gap-8 items-center">
      <EbookCover size="md" />
      <div>
        <span class="pp-badge bg-[#eef4ee] text-[#004c25]">Free ebook · PDF</span>
        <h2 class="mt-3 text-2xl md:text-3xl font-extrabold">{EBOOK.title}</h2>
        <p class="mt-2 text-muted text-lg">{EBOOK.subtitle}.</p>
        <p class="mt-2 text-muted">
          Seven stages, from testing your idea to spending your first peso, plus a dashboard and starting document
          frameworks.
        </p>
        <a
          href={getPermalink(EBOOK.route)}
          class="btn-primary mt-6"
          data-track="ebook_cta_click"
          data-placement="resources"
        >
          Get Free Guide <Icon name="tabler:arrow-right" class="w-4 h-4 ml-2" />
        </a>
      </div>
    </article>
    <p class="mt-8 text-muted">
      More checklists and articles will be added here as they’re finished. Have a topic you’d like covered? <a
        class="underline text-[#0b7339]"
        href={getPermalink('/contact')}>Tell us</a
      >.
    </p>
  </Section>
</Layout>
