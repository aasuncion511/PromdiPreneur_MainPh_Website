---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/promdi/Section.astro';
import EbookCover from '~/components/promdi/EbookCover.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import { BRAND, CTA, EBOOK, FEATURES } from '~/data/brand';

// v3 §8.5. Live copy only when the guide is live; the download link appears only after a confirmed submission
// in this browser session (sessionStorage flag set by EbookForm on server success) and only if the file ships.
const metadata = { title: 'Your Free Guide', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <Section id="ty" narrow>
    <div class="grid sm:grid-cols-[auto_1fr] gap-8 items-center">
      <EbookCover size="sm" />
      {
        FEATURES.ebookLive ? (
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold">Your free guide is on its way. Please check your email.</h1>
            <p class="mt-4 text-lg text-muted">
              We’re emailing <em>{EBOOK.title}</em> to the address you entered. It usually arrives within a few minutes.
            </p>
            <p class="mt-3 text-sm text-muted">
              Not in your inbox? Check Promotions or Spam. Still nothing after 15 minutes? Email{' '}
              <TrackedLink dest="email" placement="ebook_thank_you" class="underline text-[#00441b]">
                {BRAND.email}
              </TrackedLink>
              .
            </p>
            <a
              id="ebook-download"
              hidden
              href={EBOOK.pdfPath}
              class="btn-primary mt-6"
              data-track="ebook_download_click"
              data-placement="ebook_thank_you"
            >
              <Icon name="tabler:download" class="w-5 h-5 mr-2" /> Download Your Ebook
            </a>
          </div>
        ) : (
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold">The free guide isn’t available to request yet.</h1>
            <p class="mt-4 text-lg text-muted">
              Nothing has been sent and no details were collected. Requests open soon.
            </p>
          </div>
        )
      }
    </div>
    <div class="mt-12 rounded-2xl bg-[#eef4ee] p-6">
      <h2 class="text-xl font-bold">Want a hand putting it into practice?</h2>
      <p class="mt-2 text-muted">
        The free Business Discovery takes about 5 minutes online and shows where to start. No call needed.
      </p>
      <TrackedLink dest="discovery" placement="ebook_thank_you" sameTab class="btn mt-4 bg-white"
        >{CTA.primary}</TrackedLink
      >
    </div>
  </Section>
</Layout>
<script>
  try {
    if (sessionStorage.getItem('pp-ebook-ok') === '1')
      document.getElementById('ebook-download')?.removeAttribute('hidden');
  } catch {
    /* email delivery still applies */
  }
</script>
