---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/promdi/Header.astro';
import Footer from '~/components/promdi/Footer.astro';
import TrackedLink from '~/components/promdi/TrackedLink.astro';
import { Icon } from 'astro-icon/components';
import { FEATURES } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

// Preview builds (PUBLIC_PREVIEW=1, set for Netlify deploy previews/branch deploys) are never indexable.
const preview = import.meta.env.PUBLIC_PREVIEW === '1';
const { metadata = {} } = Astro.props;
// Sticky Messenger button on phones (Allan, 2026-11-01). Hidden on thank-you pages, where the visitor already acted.
const showSticky = !/thank-you/.test(Astro.url.pathname);
// Ask PromdiPreneur launcher (Feature Addendum 01): everywhere except the chat page itself and thank-you pages.
const showAsk = FEATURES.askLive && showSticky && !/^\/ask\/?$/.test(Astro.url.pathname);
const meta: MetaData = preview ? { ...metadata, robots: { index: false, follow: false } } : metadata;
---

<Layout metadata={meta}>
  {
    preview && (
      <div
        class="bg-[#4d3300] text-[#fff3dc] text-center text-xs font-semibold tracking-wide py-1.5 px-3 font-heading"
        role="note"
      >
        Preview for approval — not the live site
      </div>
    )
  }
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn-primary"
    >Skip to content</a
  >
  <Header />
  <main id="main" tabindex="-1" class="outline-none">
    <slot />
  </main>
  <Footer />
  {
    showSticky && (
      <>
        <div class="h-20 lg:hidden" aria-hidden="true" />
        <aside aria-label="Quick contact" class="lg:hidden">
          {showAsk && (
            <a
              href={getPermalink('/ask')}
              class="fixed bottom-4 left-4 z-30 inline-flex items-center gap-2 min-h-[52px] rounded-full bg-white px-4 font-heading text-[15px] font-bold text-[#00441b] shadow-[0_10px_30px_rgba(0,0,0,.25)] ring-2 ring-[#00441b]"
              data-placement="ask_launcher_mobile"
            >
              <Icon name="tabler:sparkles" class="w-5 h-5" aria-hidden="true" />
              Ask AI
            </a>
          )}
          <TrackedLink
            dest="messenger"
            placement="sticky_mobile"
            class="pp-sticky-msg lg:hidden fixed bottom-4 right-4 z-30 inline-flex items-center gap-2 min-h-[52px] rounded-full bg-[#00441b] px-5 font-heading text-[15px] font-bold text-white shadow-[0_10px_30px_rgba(0,0,0,.3)] ring-2 ring-white"
          >
            <Icon name="tabler:brand-messenger" class="w-5 h-5" aria-hidden="true" />
            Message us
          </TrackedLink>
        </aside>
      </>
    )
  }
  {
    showAsk && (
      <aside aria-label="Ask PromdiPreneur" class="hidden lg:block">
        <a
          href={getPermalink('/ask')}
          class="fixed bottom-6 right-6 z-30 inline-flex items-center gap-2.5 min-h-[52px] rounded-full bg-[#00441b] pl-4 pr-5 font-heading text-[15px] font-bold text-white shadow-[0_10px_30px_rgba(0,0,0,.3)] ring-2 ring-white hover:bg-[#00330f]"
          data-placement="ask_launcher"
        >
          <Icon name="tabler:sparkles" class="w-5 h-5 text-[#5fd68f]" aria-hidden="true" />
          Ask PromdiPreneur
          <span class="rounded-full bg-[#1db259] px-2 py-0.5 text-[11px] font-extrabold text-[#00330f]">AI</span>
        </a>
      </aside>
    )
  }
</Layout>
