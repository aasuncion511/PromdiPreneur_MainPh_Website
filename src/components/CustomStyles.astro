---
import '@fontsource-variable/inter';
import '@fontsource-variable/montserrat';
---

<!--
  PromdiPreneur brand tokens (docs/BRAND_STANDARD.md). Light-only by design.
  Contrast: --aw-color-primary (#004C25 forest) and #0B7339 text-green pass AA on white;
  action green #18B957 is decorative only (never small text on light backgrounds).
-->
<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Montserrat Variable';

    --aw-color-primary: rgb(0 76 37);
    --aw-color-secondary: rgb(10 92 50);
    --aw-color-accent: rgb(24 185 87);

    --aw-color-text-heading: rgb(0 76 37);
    --aw-color-text-default: rgb(19 36 27);
    --aw-color-text-muted: rgb(60 75 67);
    --aw-color-bg-page: rgb(247 247 243);

    --aw-color-bg-page-dark: rgb(0 46 25);

    ::selection {
      background-color: rgb(24 185 87 / 30%);
    }
  }
</style>
