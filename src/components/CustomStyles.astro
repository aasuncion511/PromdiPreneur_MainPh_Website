---
import '@fontsource-variable/inter';
import '@fontsource-variable/montserrat';
---

<!--
  PromdiPreneur brand tokens (docs/BRAND_STANDARD.md). Light-only by design.
  Contrast: --aw-color-primary (#00441b forest) and #00441b text-green pass AA on white;
  action green #1db259 is decorative only (never small text on light backgrounds).
-->
<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Montserrat Variable';

    --aw-color-primary: rgb(0 68 27);
    --aw-color-secondary: rgb(10 92 50);
    --aw-color-accent: rgb(29 178 89);

    --aw-color-text-heading: rgb(0 68 27);
    --aw-color-text-default: rgb(20 35 26);
    --aw-color-text-muted: rgb(79 107 90);
    --aw-color-bg-page: rgb(247 247 243);

    --aw-color-bg-page-dark: rgb(0 51 15);

    ::selection {
      background-color: rgb(29 178 89 / 30%);
    }
  }
</style>
