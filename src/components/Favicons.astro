---
// PromdiPreneur mark (salakot + lightbulb), generated from src/assets/images/brand/mark-512.webp.
import favIcon from '~/assets/favicons/favicon.ico';
import favIconPng from '~/assets/favicons/favicon-64.png';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="icon" href={favIcon} sizes="any" />
<link rel="icon" type="image/png" href={favIconPng.src} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
<meta name="theme-color" content="#00441b" />
