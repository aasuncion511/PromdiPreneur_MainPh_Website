---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import TrackedLink from './TrackedLink.astro';
import StatusBadge from './StatusBadge.astro';
import Placeholder from './Placeholder.astro';
import { STATUS_LABEL, type Product } from '~/data/catalog';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  product: Product;
  placement: string;
  detailed?: boolean;
}
const { product: p, placement, detailed = false } = Astro.props;
---

<article
  class="pp-card overflow-hidden flex flex-col h-full transition hover:-translate-y-0.5 hover:shadow-lg motion-reduce:transform-none"
>
  <div class="aspect-[16/10] bg-[#f1f4ef] border-b border-black/5 overflow-hidden">
    {
      p.image ? (
        <Image
          src={p.image}
          alt={p.imageAlt}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
          class={`w-full h-full ${p.id === 'digital-shop' ? 'object-contain p-2' : 'object-cover object-top'}`}
          loading="lazy"
        />
      ) : (
        <Placeholder
          label={p.name}
          steps={['Search dates', 'Hold', 'Release', 'Return']}
          note="Illustration · in development"
        />
      )
    }
  </div>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex flex-wrap gap-2 mb-3">
      <StatusBadge status={STATUS_LABEL[p.status]} />
      {detailed && <span class="pp-badge bg-[#eef4ee] text-[#004c25]">{p.category}</span>}
    </div>
    <h3 class="text-xl font-bold">{p.name}</h3>
    <p class="mt-2 text-muted">{p.summary}</p>
    {
      detailed && (
        <>
          <p class="mt-3 text-sm">
            <strong>For:</strong> {p.forWho}
          </p>
          <ul class="mt-3 space-y-1.5 text-sm">
            {p.includes.map((i) => (
              <li class="flex gap-2">
                <Icon name="tabler:check" class="w-4 h-4 mt-0.5 shrink-0 text-[#0b7339]" />
                {i}
              </li>
            ))}
          </ul>
        </>
      )
    }
    <div class="mt-auto pt-5 flex flex-col gap-2">
      {
        p.cta ? (
          <TrackedLink dest={p.cta.destination} placement={placement} class="btn-primary w-full">
            {p.cta.label} <Icon name="tabler:external-link" class="w-4 h-4 ml-1.5" />
          </TrackedLink>
        ) : (
          <a
            href={getPermalink('/contact')}
            class="btn w-full"
            data-track="product_interest_click"
            data-placement={placement}
          >
            Ask about early access
          </a>
        )
      }
      {
        detailed && p.secondaryCta && (
          <TrackedLink dest={p.secondaryCta.destination} placement={placement} class="pp-text-link justify-center">
            {p.secondaryCta.label}
          </TrackedLink>
        )
      }
    </div>
  </div>
</article>
