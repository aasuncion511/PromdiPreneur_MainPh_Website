---
/** The supplied cover of the free ebook, shown unaltered (Final Ebook Addendum §1). */
import { Image } from 'astro:assets';
import cover from '~/assets/images/ebook/business-opening-checklist-ph-cover.webp';
import { EBOOK } from '~/data/brand';

export interface Props {
  size?: 'sm' | 'md' | 'lg';
  eager?: boolean;
}
const { size = 'md', eager = false } = Astro.props;
const w = { sm: 'w-[min(170px,45vw)]', md: 'w-[min(230px,62vw)]', lg: 'w-[min(320px,78vw)]' }[size];
---

<figure class:list={[w, 'mx-auto shrink-0']}>
  <Image
    src={cover}
    alt={`Cover of the free ebook "${EBOOK.title}: ${EBOOK.subtitle}" by ${EBOOK.author}, PromdiPreneur`}
    widths={[240, 320, 480, 640]}
    sizes="(min-width: 768px) 320px, 78vw"
    class="w-full h-auto rounded-md shadow-[0_24px_50px_-18px_rgba(0,46,25,.55)] ring-1 ring-black/10 motion-safe:transition-transform motion-safe:hover:-rotate-1"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>
