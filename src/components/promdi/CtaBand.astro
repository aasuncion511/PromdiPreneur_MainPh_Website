---
import { CTA } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';
const {
  title = 'What’s causing missed leads or wasted admin time in your business?',
  body = 'Let’s find out together in a short, free Discovery Session.',
  placement = 'final_cta',
} = Astro.props;
---

<section class="bg-gradient-to-r from-[#002e19] via-[#004c25] to-[#0a5c32] text-[#e1ece5] py-16 md:py-20 text-center">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <h2 class="!text-white text-3xl md:text-4xl font-extrabold">{title}</h2>
    <p class="mt-4 text-lg">{body}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href={getPermalink('/discovery')} class="btn-light" data-placement={placement}>{CTA.primary}</a>
      <a
        href={getPermalink('/contact')}
        class="btn !text-white !border-white/40 hover:!bg-white/10"
        data-placement={placement}>Not ready to book? Send a question</a
      >
    </div>
  </div>
</section>
