---
import { CTA } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';
import TrackedLink from './TrackedLink.astro';
const {
  title = 'What’s causing missed leads or wasted admin time in your business?',
  body = 'Take the free 5-minute Business Discovery. You’ll see your biggest leak and where to start.',
  placement = 'final_cta',
} = Astro.props;
---

<section class="bg-gradient-to-r from-[#00330f] via-[#00441b] to-[#0a5c32] text-[#e1ece5] py-16 md:py-20 text-center">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <h2 class="!text-white text-3xl md:text-4xl font-extrabold">{title}</h2>
    <p class="mt-4 text-lg">{body}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <TrackedLink dest="discovery" placement={placement} sameTab class="btn-light">{CTA.primary}</TrackedLink>
      <a
        href={getPermalink('/diagnostic')}
        class="btn !text-white !border-white/40 hover:!bg-white/10"
        data-placement={placement}>Talk to Allan: free Diagnostic</a
      >
    </div>
  </div>
</section>
