---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import TrackedLink from './TrackedLink.astro';
import StatusBadge from './StatusBadge.astro';
import Placeholder from './Placeholder.astro';
import type { WorkItem } from '~/data/catalog';

const {
  item: w,
  placement,
  headingLevel = 'h3',
} = Astro.props as { item: WorkItem; placement: string; headingLevel?: 'h2' | 'h3' };
const H = headingLevel;
const placeholderSteps: Record<string, string[]> = {
  minbizcon: ['Attendee record', 'Unique QR', 'Desk scan', 'Attendance'],
  'car-rental-os': ['Search dates', 'Hold', 'Release', 'Return'],
  'socri-website': ['Packages', 'Photo tour', 'Pick a date', 'Request'],
  'socri-booking': ['Inquiry', 'Payment verified', 'Calendar', 'SMS + email'],
};
---

<article class="pp-card overflow-hidden flex flex-col h-full">
  <div class="aspect-[16/10] border-b border-black/5 overflow-hidden bg-[#f1f4ef]">
    {
      w.image ? (
        <Image
          src={w.image}
          alt={w.imageAlt}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
          class="w-full h-full object-cover object-top"
          loading="lazy"
        />
      ) : (
        <Placeholder label={w.title} steps={placeholderSteps[w.id] ?? []} />
      )
    }
  </div>
  <div class="p-6 flex flex-col flex-1">
    <div><StatusBadge status={w.status} /></div>
    <H class="mt-3 text-xl font-bold">{w.title}</H>
    <p class="text-sm text-muted">{w.context}</p>
    <dl class="mt-4 space-y-3 text-[0.95rem] flex-1">
      <div><dt class="pp-badge !p-0 text-[#0b7339]">Problem</dt><dd class="text-muted">{w.problem}</dd></div>
      <div><dt class="pp-badge !p-0 text-[#0b7339]">Approach</dt><dd class="text-muted">{w.approach}</dd></div>
      <div><dt class="pp-badge !p-0 text-[#0b7339]">What was built</dt><dd class="text-muted">{w.built}</dd></div>
    </dl>
    <TrackedLink
      dest="portfolio"
      href={w.caseStudyUrl}
      event="case_study_click"
      placement={placement}
      class="pp-text-link mt-4"
    >
      Read the case study <Icon name="tabler:arrow-right" class="w-4 h-4" />
    </TrackedLink>
  </div>
</article>
