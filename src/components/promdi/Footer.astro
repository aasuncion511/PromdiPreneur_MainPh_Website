---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logoWhite from '~/assets/images/brand/promdipreneur-logo-white-1200.webp';
import TrackedLink from './TrackedLink.astro';
import { BRAND, CTA } from '~/data/brand';
import { getPermalink } from '~/utils/permalinks';

const year = new Date().getFullYear();
const col = (title: string, links: { text: string; href: string }[]) => ({ title, links });
const explore = col('Explore', [
  { text: 'What We Do', href: getPermalink('/services') },
  { text: 'Our Work', href: getPermalink('/work') },
  { text: 'Digital Store', href: getPermalink('/products') },
  { text: 'About', href: getPermalink('/about') },
  { text: CTA.primary, href: getPermalink('/discovery') },
  { text: 'Contact', href: getPermalink('/contact') },
]);
const resources = col('Resources', [
  { text: 'Free Ebook', href: getPermalink('/resources/free-ebook') },
  { text: 'All Resources', href: getPermalink('/resources') },
]);
---

<!-- Homepage v2 §3.14: deep footer green, no "Cagayan de Oro" here (Allan). The logo only works on light
     backgrounds, so the footer uses the white (reversed) version, made from the official logo (Allan OK 2026-11-01). Link columns stay so About and the ebook remain reachable
     after the nav was cut to 4 links (decision 2A). -->
<footer class="bg-[#00260a] text-[#c9dccf] text-[0.95rem]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-3">
      <Image
        src={logoWhite}
        alt="PromdiPreneur"
        widths={[240, 480]}
        sizes="200px"
        class="h-[90px] w-auto"
        loading="lazy"
      />
      <p class="mt-3 max-w-sm"><strong class="text-white">{BRAND.role}.</strong> {BRAND.promise}</p>
      <p class="mt-5 font-heading text-xs font-extrabold tracking-[0.16em] text-[#5fd68f]">{BRAND.tagline}</p>
    </div>
    {
      [explore, resources].map((c) => (
        <div class="lg:col-span-2">
          <h2 class="pp-footer-h">{c.title}</h2>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="pp-footer-link">
                  {l.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="lg:col-span-2">
      <h2 class="pp-footer-h">Business Tools</h2>
      <ul>
        <li><TrackedLink dest="shop" placement="footer" class="pp-footer-link">Digital Shop</TrackedLink></li>
        <li><TrackedLink dest="kits" placement="footer" class="pp-footer-link">Cleaning Business Kits</TrackedLink></li>
        <li>
          <TrackedLink dest="payroll" placement="footer" class="pp-footer-link">PromdiPreneur Payroll</TrackedLink>
        </li>
      </ul>
    </div>
    <div class="sm:col-span-2 lg:col-span-3">
      <h2 class="pp-footer-h">Contact</h2>
      <ul>
        <li>
          <TrackedLink dest="email" placement="footer" class="pp-footer-link"
            ><Icon name="tabler:mail" class="w-4 h-4 mr-1.5 shrink-0" />{BRAND.email}</TrackedLink
          >
        </li>
        <li>
          <TrackedLink dest="messenger" placement="footer" class="pp-footer-link"
            ><Icon name="tabler:brand-messenger" class="w-4 h-4 mr-1.5" />Messenger</TrackedLink
          >
        </li>
        <li>
          <TrackedLink dest="facebook" placement="footer" class="pp-footer-link"
            ><Icon name="tabler:brand-facebook" class="w-4 h-4 mr-1.5" />Facebook</TrackedLink
          >
        </li>
        <li>
          <TrackedLink dest="linkedin" placement="footer" class="pp-footer-link"
            ><Icon name="tabler:brand-linkedin" class="w-4 h-4 mr-1.5" />LinkedIn</TrackedLink
          >
        </li>
        <li>
          <TrackedLink dest="portfolio" placement="footer" class="pp-footer-link">Portfolio</TrackedLink>
        </li>
      </ul>
    </div>
  </div>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 py-4 border-t border-white/10 flex flex-wrap gap-x-6 gap-y-1 justify-between items-center text-sm"
  >
    <p>© {year} {BRAND.name} · From Diskarte to Systems.</p>
    <p class="flex flex-wrap items-center gap-x-4">
      <a
        href={getPermalink('/privacy')}
        class="underline underline-offset-2 inline-flex min-h-[44px] items-center hover:text-white">Privacy Policy</a
      >
      <a
        href={getPermalink('/terms')}
        class="underline underline-offset-2 inline-flex min-h-[44px] items-center hover:text-white">Terms</a
      >
      <button type="button" class="underline underline-offset-2 min-h-[44px] hidden hover:text-white" data-open-consent
        >Analytics settings</button
      >
    </p>
  </div>
</footer>
