---
const { status } = Astro.props as { status: string };
const progress = /development|concept|coming|pending|to be built|preview/i.test(status);
const live = !progress && /available|built|supported|live/i.test(status);
---

<span
  class:list={[
    'pp-badge',
    live ? 'bg-green-50 text-[#0b7339]' : progress ? 'bg-[#f6ecdf] text-[#754000]' : 'bg-[#eef4ee] text-[#004c25]',
  ]}>{status}</span
>
