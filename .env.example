# ---- Public (build time; baked into pages — never secrets) ----
PUBLIC_PREVIEW=0                 # 1 = noindex + preview ribbon (netlify.toml sets it for previews)
PUBLIC_GA4_ID=                   # G-XXXXXXXXXX. Empty = GA4 off
PUBLIC_UMAMI_WEBSITE_ID=         # Umami website id. Empty = Umami off
PUBLIC_UMAMI_SRC=                # e.g. https://cloud.umami.is/script.js

# ---- Server (Netlify environment variables; secret) ----
RESEND_API_KEY=                  # contact form goes live when this + INQUIRY_NOTIFY_FROM are set
INQUIRY_NOTIFY_FROM=PromdiPreneur Website <website@promdipreneur.com>
INQUIRY_NOTIFY_TO=admin@promdipreneur.com
IP_HASH_SALT=                    # long random string
EXPORT_TOKEN=                    # enables GET /api/inquiries.csv (Bearer token). Empty = disabled
GHL_PRIVATE_TOKEN=               # GHL Private Integration token (contacts.write + locations/customFields.readonly). Empty = no CRM sync
GHL_LOCATION_ID=9AKY7kTTUdEnC8FLOMwh   # GHL sub-account (location) id (also set in netlify.toml)
GHL_CUSTOM_FIELDS=               # OPTIONAL override. Normally empty: field ids are looked up by key automatically
EBOOK_ACTIVE=false               # true only after final PDF + cover + GHL delivery workflow are approved
